.worktrees/

# Emacs autosave / lock / backup files
\#*\#
.\#*
*~

# NOTE: patterns for paths listed in .worktree-links must NOT end in "/", so
# that they also match the symlinks worktree.sh creates for them (git sees a
# symlink as a file, and "foo/" only matches a real directory).

