# Gitignored paths that ./worktree.sh symlinks from the central tree into every
# new worktree. One repo-relative path per line; missing or git-tracked paths
# are skipped with a warning.
#
# These are SHARED, not copies. Writing to them from a worktree is visible to
# the central tree, to every other worktree, and to running jobs.

# The TRL clone that actually executes (tracked trl/ is only the source copy).
# Shared on purpose so a worktree runs the same code as everything else --
# which also means patch_trl_qwen3.sh from a worktree patches it for everyone.
trl_repo

# The EASE (EasyR1/verl fork) clone that actually executes, shared the same way.
# Upstream is github.com/Nrich-sunny/Attend-to-Evidence; ease/ holds our source
# copy of anything we change on top of it.
ease_repo

# Downloaded / derived cold-start data
cold_data/LLaVA-CoT-100k
cold_data/Mulberry-SFT
cold_data/Saliency-R1-cold

# EASE source corpora and the evidence-annotated parquet built from them.
# ~51 GB of downloads; shared so a worktree deletion never takes them with it.
cold_data/ease

# Training artifacts. Point run scripts at a per-branch subdirectory so two
# sessions don't clobber each other's checkpoints and logs.
checkpoint
outputs

# Claude Code project settings (permissions, hooks) -- not tracked
.claude

# Validation sets, so a worktree can run the val probes without an absolute path.
cold_data/grpo_sets

# LASER's RL corpora (MMR1-RL + ReVisual-R1) and the verl parquet built from
# them by build_laser_data.py. ~2 GB; one copy is enough.
cold_data/laser

# LASER's released fork, read-only reference for docs/laser-go-no-go.md. Shared
# because it is 3.7 MB of someone else's git history and every worktree wants the
# same copy.
laser_repo

# Our fork of LASER's verl repo, on branch qwen3-vl -- the copy that actually
# executes, patched by patch_laser_qwen3.sh. Shared like trl_repo, which means
# re-patching it from a worktree re-patches it for every session.
laser_fork
